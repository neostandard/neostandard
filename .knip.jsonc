{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // lib/main.js and index.js load these lazily via createRequire (require(esm)),
  // which knip's import graph cannot see — declare them as entries so their
  // exports count as used.
  "entry": [
    "test/*eslint.config.js",
    "test/rules/*.test.js",
    "lib/configs/jsx.js",
    "lib/configs/style.js",
    "lib/configs/base.js",
    "lib/plugin/index.js",
    "lib/ts.js",
    "lib/tseslint.js"
  ],
  "ignore": [
    "test/should-*/**/*"
  ],
  "ignoreBinaries": [
    "diff"
  ]
}
