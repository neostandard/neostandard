{
  "extends": "@voxpelli/tsconfig/node22.json",
  "files": [
    "cli.js",
    "eslint.config.js",
    "index.js"
  ],
  "include": [
    "lib/**/*",
    "test/**/*",
  ],
  "exclude": [
    "test/**/*.jsx",
  ],
  "compilerOptions": {
    "jsx": "preserve",
    // Enable require(esm) type resolution for the ESM-only @stylistic/eslint-plugin v5
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Temporary: Until typescript-eslint passes without it
    "skipLibCheck": true
  }
}
